{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dewday-static-web-application",
  "main": "src/worker.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_NAME": "Dewday"
  },
  "observability": {
    "enabled": true
  }
}
